# RailCrowd environment configuration
FLASK_CONFIG=development
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
PORT=5000

# Replace with a unique random value before deployment (32+ characters).
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

# SQLite database; Flask-SQLAlchemy resolves this relative to the instance folder.
DATABASE_URL=sqlite:///railcrowd.db
SQLALCHEMY_ECHO=false
MAX_CONTENT_LENGTH=5242880

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional external train-data integration (configure only when approved).
TRAIN_DATA_API_BASE_URL=
TRAIN_DATA_API_KEY=
