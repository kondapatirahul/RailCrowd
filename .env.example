# RailCrowd environment configuration example
# Copy this file to .env for local development when backend setup is added.

FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///railcrowd.db

# Optional external integrations (leave blank until configured)
TRAIN_DATA_API_BASE_URL=
TRAIN_DATA_API_KEY=
